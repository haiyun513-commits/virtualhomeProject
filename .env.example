# ============================================
# AI Companion Template - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# --- Supabase (Required) ---
# Create a free project at https://supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key-here

# --- Embedding API (Required for memory system) ---
# SiliconFlow, OpenAI, or any OpenAI-compatible API
EMBEDDING_API_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# --- Server URL ---
# For local development: http://localhost:3000
# For VPS deployment: http://your-vps-ip:3000
SERVER_URL=http://localhost:3000

# --- Optional: Chat API (for memory system search enhancement) ---
# CHAT_API_URL=https://api.openai.com/v1
# CHAT_API_KEY=your-chat-api-key
# CHAT_MODEL=gpt-4o

# --- Optional: Notion Integration ---
# For schedule overview and diary features
# NOTION_TOKEN=your-notion-integration-token
# NOTION_SCHEDULE_DB=your-notion-database-id
# NOTION_DIARY_PAGE=your-notion-page-id

# --- Optional: Discord Bot ---
# For auto-activity life event notifications
# DISCORD_TOKEN=your-discord-bot-token
# DISCORD_CHANNEL_ID=your-discord-channel-id

# --- Optional: TTS (Text-to-Speech) ---
# TTS_API_KEY=your-tts-api-key
# TTS_VOICE_ID=your-voice-id
